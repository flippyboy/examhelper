{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://examhelper.local/exams/schema.json",
  "title": "ExamHelper exam pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "vendor",
    "version",
    "description",
    "unofficial",
    "passPercent",
    "timeLimitMinutes",
    "domains",
    "questions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "Must match the folder name under public/exams/"
    },
    "title": { "type": "string", "minLength": 1 },
    "vendor": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "description": "Vendor exam code, e.g. AZ-104" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "unofficial": {
      "type": "boolean",
      "description": "Must be true. Packs are unofficial practice, not vendor items."
    },
    "passPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
    "timeLimitMinutes": { "type": "integer", "minimum": 1 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "weight"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "weight": {
            "type": "number",
            "minimum": 0,
            "description": "Percentage of the exam. Domain weights must sum to 100."
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "questionBase": {
      "type": "object",
      "required": ["id", "type", "domain", "objective", "stem", "answer", "explanation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "stem": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "url": { "type": "string" }
            }
          }
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "question": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/questionBase" },
            {
              "type": "object",
              "required": ["type", "choices", "answer"],
              "properties": {
                "type": { "const": "single" },
                "choices": {
                  "type": "array",
                  "minItems": 2,
                  "items": { "$ref": "#/$defs/choice" }
                },
                "answer": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": { "type": "string" }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/questionBase" },
            {
              "type": "object",
              "required": ["type", "choices", "selectCount", "answer"],
              "properties": {
                "type": { "const": "multi" },
                "selectCount": { "type": "integer", "minimum": 2 },
                "choices": {
                  "type": "array",
                  "minItems": 3,
                  "items": { "$ref": "#/$defs/choice" }
                },
                "answer": {
                  "type": "array",
                  "minItems": 2,
                  "items": { "type": "string" }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/questionBase" },
            {
              "type": "object",
              "required": ["type", "choices", "answer"],
              "properties": {
                "type": { "const": "truefalse" },
                "choices": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "$ref": "#/$defs/choice" }
                },
                "answer": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": { "type": "string" }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/questionBase" },
            {
              "type": "object",
              "required": ["type", "answer"],
              "properties": {
                "type": { "const": "fill" },
                "answer": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
